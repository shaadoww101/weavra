# Weavra — copy to .env and fill in. NEVER commit a real .env with keys.
# Port the server listens on (Render sets PORT automatically).
PORT=3000

# LLM provider — OpenAI is the primary/default choice.
# LLM_PROVIDER=openai
# Leave the key blank for DEMO MODE: chat answers are built from the seeded
# knowledge base and labelled DEMO, never live AI.
LLM_PROVIDER=openai

# Model override (optional). Default for OpenAI is gpt-4o-mini.
# LLM_MODEL takes precedence over OPENAI_MODEL.
LLM_MODEL=
OPENAI_MODEL=gpt-4o-mini

# Primary provider key — set this in your hosting dashboard / .env at deploy time.
OPENAI_API_KEY=

# Fallbacks (only used if you set LLM_PROVIDER=anthropic or LLM_PROVIDER=cohere):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# LLM_PROVIDER=cohere
# COHERE_API_KEY=
# COHERE_MODEL=command-a-03-2025

# Optional: where the JSON database lives. Default: ./data/db.json
# DATA_FILE=/var/data/db.json
